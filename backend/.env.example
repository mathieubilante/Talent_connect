# Copier en .env puis adapter
DATABASE_URL=sqlite:///./talentconnect.db
# Pour PostgreSQL : postgresql://tc_user:tc_password@localhost:5432/talentconnect
SECRET_KEY=changez-cette-cle-en-production
ACCESS_TOKEN_EXPIRE_MINUTES=120
CORS_ORIGINS=http://localhost:5173

# --- Code OTP ---
OTP_DEV_MODE=true            # true : le code est aussi renvoyé par l'API (démo). false en production
OTP_DELIVERY=console         # console : code affiché dans le terminal ; smtp : envoi réel par e-mail
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=votre.adresse@gmail.com
# SMTP_PASSWORD=mot-de-passe-d-application
# SMTP_FROM=votre.adresse@gmail.com
DEFAULT_COUNTRY_CODE=+228
